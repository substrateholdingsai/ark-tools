{
  "name": "ark-tools",
  "version": "1.0.0",
  "description": "ARK LEDGER — Suite de herramientas modernas para contadores. Worker unificado en Cloudflare.",
  "private": true,
  "type": "module",
  "author": "Substrate Holdings LLC",
  "license": "UNLICENSED",
  "homepage": "https://ledger.arksystems.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substrateholdingsai/ark-tools.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "deploy": "pnpm run deploy:production",
    "deploy:preview": "pnpm build && wrangler deploy",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "deploy:production": "pnpm build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "verify:catalogo": "tsx scripts/verificar-catalogo.ts",
    "watch:dof": "python scripts/dof_sat_watcher.py",
    "generate:stress-cfdi": "python scripts/cfdi_stress_generator.py",
    "audit:d1": "python scripts/d1_audit_verifier.py",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist node_modules/.vite .wrangler/tmp",
    "prepare": "husky install"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "jszip": "^3.10.2",
    "lucide-react": "^0.400.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jszip": "^3.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.4",
    "jsdom": "^30.1.2",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.78.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.7.0"
}
