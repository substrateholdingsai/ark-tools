# ─────────────────────────────────────────────────────────────────────
# ARK LEDGER — Variables de desarrollo local
# Copiar a `.dev.vars` y llenar con valores reales.
# NO commitear este archivo. Solo `.dev.vars.example`.
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# AUTH NATIVO (Zero-Dependency & Multi-Tenant Sovereign)
# No requiere claves de terceros. Sincroniza directamente con Cloudflare D1.
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# CLIP DEVELOPERS (API CHECKOUT & LINKS DE PAGO)
# Obtén tus API Keys en: https://developer.clip.mx/docs/getting-started
# ─────────────────────────────────────────────────────────────────────
CLIP_API_KEY=test_api_key_xxxxxxxxxxxxxxxx
CLIP_API_SECRET=test_api_secret_xxxxxxxxxxxxxxxx
CLIP_ENVIRONMENT=sandbox # 'sandbox' | 'production'

# Si en el futuro se integra IA para borradores
# OPENAI_API_KEY=sk-...

# Conekta (CANACO SERVYTUR Mérida — merchant of record)
# Obtén tus llaves en: https://panel.conekta.com/
# CONEKTA_PRIVATE_KEY=key_xxxxxxxxxxxxxxxx
# CONEKTA_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CONEKTA_ENVIRONMENT=sandbox # 'sandbox' | 'production'

# Proxy Ledger → Ark Sales para comunicaciones CANACO.
# Configurar la URL, el ID tenant allowlisted en Sales y el secreto solo en el Worker.
# No proporcionar `SALES_WORKER_INTERNAL_KEY` a la SPA ni a variables VITE_*.
# SALES_WORKER_URL=https://sales-worker.example.com
# SALES_WORKER_INTERNAL_KEY=replace_with_worker_secret
# CANACO_SALES_TENANT_ID=tenant_id_configured_in_sales_allowlist
# Sales también requiere LEDGER_API_URL y LEDGER_COMMS_INTERNAL_KEY con esta misma clave.

# Si en el futuro se integra analytics
# POSTHOG_API_KEY=phc_...

# Webhook para alertas del monitor DOF/SAT (Discord / Slack / Resend)
# ARK_WATCHER_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Cloudflare API (para auditoría y reconciliación forense D1)
# CLOUDFLARE_API_TOKEN=cf_token_xxxxxxxxxxxxxxxx
# CLOUDFLARE_ACCOUNT_ID=account_id_xxxxxxxxxxxxxxxx
# AUDIT_TENANT_ID=opcional_id_del_despacho


